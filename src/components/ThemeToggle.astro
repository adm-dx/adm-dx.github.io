---
import Icon from './Icon.astro';

interface Props {
  label: string;
}

const { label } = Astro.props;
---

<button type="button" class="theme-toggle no-print" aria-label={label} title={label} data-theme-toggle>
  <span class="icon icon-sun"><Icon name="sun" /></span>
  <span class="icon icon-moon"><Icon name="moon" /></span>
</button>

<script>
  // Переключатель темы. Начальное состояние уже выставлено инлайн-скриптом
  // в <head> (см. Base.astro), здесь только реакция на клик.
  const STORAGE_KEY = 'theme';
  const root = document.documentElement;

  function currentTheme(): 'light' | 'dark' {
    const explicit = root.dataset.theme;
    if (explicit === 'light' || explicit === 'dark') return explicit;
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    button.addEventListener('click', () => {
      const next = currentTheme() === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem(STORAGE_KEY, next);
      } catch {
        // Приватный режим или заблокированные site data — тема просто не запомнится.
      }
    });
  }
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text-muted);
    cursor: pointer;
  }

  .theme-toggle:hover {
    border-color: var(--border-strong);
    color: var(--text);
  }

  /* Показываем иконку того состояния, в которое переключимся. */
  .icon {
    display: none;
    line-height: 0;
  }

  .icon-moon {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .icon-moon {
      display: none;
    }

    :global(:root:not([data-theme='light'])) .icon-sun {
      display: block;
    }
  }

  :global(:root[data-theme='dark']) .icon-moon {
    display: none;
  }

  :global(:root[data-theme='dark']) .icon-sun {
    display: block;
  }

  :global(:root[data-theme='light']) .icon-moon {
    display: block;
  }

  :global(:root[data-theme='light']) .icon-sun {
    display: none;
  }
</style>
