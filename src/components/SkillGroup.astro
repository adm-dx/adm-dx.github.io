---
import type { SkillGroup } from '../data/types';

interface Props {
  group: SkillGroup;
}

const { group } = Astro.props;
---

<div class="group">
  <h3>{group.label}</h3>
  <ul>
    {group.items.map((item) => <li>{item}</li>)}
  </ul>
</div>

<style>
  .group + .group {
    margin-top: 1.25rem;
  }

  h3 {
    margin-bottom: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  li {
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--chip-bg);
    color: var(--text-muted);
    font-size: 0.8125rem;
    line-height: 1.5;
  }
</style>
